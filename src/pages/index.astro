---
import { AUDITREADY_SITE_URL } from '../lib/auditready';
import Layout from '../layouts/Layout.astro';
import ProcessSheet from '../components/site/ProcessSheet.astro';
import EditorialCTA from '../components/site/EditorialCTA.astro';
import HomeChatSection from '../components/site/HomeChatSection.astro';
import { breadcrumbListJsonLd } from '../lib/seo/structuredData';

const title = 'Home';
const description =
  'Software su misura, AI governata e compliance operativa: tre flussi, un sistema leggibile, guardrail ed evidenze verificabili.';

const site = Astro.site ?? new URL('https://devisia.pro');
const breadcrumbs = breadcrumbListJsonLd({
  site,
  items: [{ name: 'Home', url: '/' }],
});
---

<Layout
  title={title}
  documentTitle="Devisia | Software governabile, AI e compliance operativa"
  description={description}
  structuredData={[breadcrumbs]}
  containMain={false}
>
  <ProcessSheet lang="it" />

  <section class="ds-container sheet-section" aria-labelledby="home-problema">
    <p class="sheet-section__kicker">Anomalia di partenza</p>
    <h2 id="home-problema" class="site-h2">Automatizzare un flusso opaco non lo governa: lo accelera</h2>
    <p class="site-lead">
      Se ruoli, dati e vincoli restano impliciti, ogni integrazione — software o AI — moltiplica eccezioni e debito.
      Prima rendiamo leggibile il processo; poi costruiamo ciò che lo sostiene.
    </p>
  </section>

  <section class="site-section site-section--tint" aria-labelledby="home-tre">
    <section class="ds-container">
      <p class="sheet-section__kicker">Tre linee di processo</p>
      <h2 id="home-tre" class="site-h2">Un foglio, tre flussi, un sistema</h2>
      <p class="site-lead">
        Non moduli scollegati: Software, AI governata e compliance confluiscono nello stesso schema, con guardrail e prove su ogni passaggio critico.
      </p>
      <section class="sheet-rail">
        <article class="sheet-rail__item">
          <span class="sheet-rail__tag">TAG · SW</span>
          <h3>Software su misura</h3>
          <p>Piattaforme che durano, si integrano e restano manutenibili — decisioni basate su evidenze, non su ipotesi.</p>
        </article>
        <article class="sheet-rail__item">
          <span class="sheet-rail__tag">TAG · AI</span>
          <h3>AI governata</h3>
          <p>Assistant, RAG e workflow solo dove esistono confini, logging, validazione, supervisione umana e responsabilità chiare.</p>
        </article>
        <article class="sheet-rail__item">
          <span class="sheet-rail__tag">TAG · CP</span>
          <h3>Compliance operativa</h3>
          <p>Non policy decorative: la capacità continua di dimostrare chi ha fatto cosa, quando, e con quali prove.</p>
        </article>
      </section>
    </section>
  </section>

  <section class="ds-container sheet-section" aria-labelledby="home-prove">
    <p class="sheet-section__kicker">Catena di prova</p>
    <h2 id="home-prove" class="site-h2">Dal lavoro reale all’evidenza esportabile</h2>
    <p class="site-lead">
      Ogni guardrail deve lasciare traccia. Capire dove nasce il rischio, fissare i confini, rendere ogni decisione leggibile quando serve dimostrarla.
    </p>
    <ol class="sheet-chain">
      <li>
        <span class="sheet-rail__tag">Metodo</span>
        <h3>Prima il processo</h3>
        <p>Intervistiamo operatori, eccezioni e regole non scritte prima di scegliere stack, automazioni o modelli.</p>
        <a class="ds-link" data-variant="muted" href="/metodo">Come lavoriamo <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <span class="sheet-rail__tag">AI</span>
        <h3>Modelli dentro perimetri</h3>
        <p>In produzione servono limiti, log, validazione, policy e una responsabilità umana nominata.</p>
        <a class="ds-link" data-variant="muted" href="/ai-governata">AI governata <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <span class="sheet-rail__tag">Compliance</span>
        <h3>Le intenzioni non bastano</h3>
        <p>GDPR, NIS2, DORA e ISO 27001 reggono quando ogni controllo produce evidenze leggibili.</p>
        <a class="ds-link" data-variant="muted" href="/compliance-auditabilita">Auditabilità <span aria-hidden="true">→</span></a>
      </li>
    </ol>
  </section>

  <HomeChatSection lang="it" />

  <section class="ds-container sheet-section" aria-labelledby="home-ar">
    <section class="sheet-titleblock">
      <p class="sheet-section__kicker">Prodotto · AuditReady</p>
      <h2 id="home-ar" class="site-h2">Quando il controllo diventa prova</h2>
      <p class="site-lead" style="margin:0">
        Raccoglie, ordina, valida ed esporta evidenze per audit e sicurezza. AI assistita dove serve; supervisione umana sempre presente.
      </p>
      <p>
        <a
          class="ds-btn"
          data-variant="primary"
          data-size="lg"
          href={AUDITREADY_SITE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Apri AuditReady
          <span class="sr-only"> (si apre in una nuova scheda)</span>
        </a>
      </p>
    </section>
  </section>

  <section class="ds-container sheet-section" aria-labelledby="home-perche">
    <p class="sheet-section__kicker">Criteri di foglio</p>
    <h2 id="home-perche" class="site-h2">Meno rumore. Più schema</h2>
    <ul class="site-list-check">
      <li>Partiamo dal processo, non dal catalogo di tecnologie.</li>
      <li>Rendiamo espliciti vincoli, dati, ruoli e responsabilità.</li>
      <li>Costruiamo software leggibile e tracciabile nel tempo.</li>
      <li>Trattiamo AI e compliance come scelte di schema, non come add-on.</li>
      <li>Privilegiamo rilasci controllati e evidenze verificabili.</li>
    </ul>
  </section>

  <EditorialCTA
    headingId="home-editorial-cta"
    title="Se il sistema deve reggere, partiamo da ciò che deve dimostrare"
    copy="Raccontaci processo, dati, rischi, vincoli e persone coinvolte. Il primo obiettivo è allineare contesto, guardrail e criteri di successo — non vendere un pacchetto pronto."
    ctaLabel="Avvia un confronto"
    ctaHref="/contatti"
  />
</Layout>
