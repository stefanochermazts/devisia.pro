---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import EditorialCTA from '../components/site/EditorialCTA.astro';
import { breadcrumbListJsonLd } from '../lib/seo/structuredData';

const description =
  'Devisia progetta e costruisce sistemi digitali governabili: software su misura, AI con perimetro e compliance operativa con evidenze.';

const site = Astro.site ?? new URL('https://devisia.pro');
const breadcrumbs = breadcrumbListJsonLd({
  site,
  items: [
    { name: 'Home', url: '/' },
    { name: 'Chi siamo', url: '/chi-siamo' },
  ],
});
---

<Layout title="Chi siamo: partner per sistemi governabili" description={description} structuredData={[breadcrumbs]}>
  <PageIntro
    eyebrow="Foglio · Chi siamo"
    h1="Il partner che mette ordine prima di accelerare"
    lede="Devisia unisce software su misura, AI governata e compliance operativa per team che hanno già qualcosa da perdere: continuità, reputazione, dati, audit."
  />

  <section class="ds-stack ds-reading" data-gap="lg" style="margin-bottom: var(--ds-space-8)">
    <h2>Perché esistiamo</h2>
    <p>
      Perché “digitale” non diventi stack fragile, requisiti sommersi, modelli senza criteri o evidenze
      sparse quando serve dimostrare. Mettiamo su foglio processi, confini e prove — poi costruiamo.
    </p>

    <h2>Problemi che affrontiamo</h2>
    <ul>
      <li>Processi e dati disallineati tra reparti, sistemi e fornitori.</li>
      <li>Software cresciuto per accumulo, opaco a chi lo usa o lo verifica.</li>
      <li>AI introdotta dove mancano perimetro, validazione o traccia.</li>
      <li>Compliance che non trova supporto in strumenti, log, export e responsabilità.</li>
    </ul>

    <h2>Come ragioniamo</h2>
    <p>
      Schema e responsabilità prima; codice e automazioni quando i guardrail sono chiari. Evidenze,
      non teatro.
    </p>

    <h2>Prodotti</h2>
    <p>
      Costruiamo <a href="/prodotti">prodotti</a> verticali quando il modo migliore per risolvere è
      rendere operativo ciò che altrimenti resta in fogli di calcolo: ordine, export, tracciamento.
    </p>

    <h2>Cosa non siamo</h2>
    <p>
      Non siamo un’agenzia full-service generica, né un fornitore di slide. Se cercate trasformazione
      senza toccare processi, non siamo allineati.
    </p>
  </section>

  <EditorialCTA
    variant="tint"
    title="Se il prossimo vincolo è serio, trattatelo con competenza"
    ctaLabel="Conosciamo il tuo contesto"
    ctaHref="/contatti"
    copy="Primo contatto: fatti, vincoli, responsabilità e criteri di accettazione — senza forzare stack o vendor."
  />
</Layout>
