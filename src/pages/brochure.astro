---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/site/ContactForm.astro';

const PAGE_PATH = '/brochure';
const LANDING_SOURCE = 'landing_brochure';
const PHONE_NUMBER = '040-9777469';
const PHONE_HREF = 'tel:+390409777469';

const documentTitle = 'Devisia | Processi e Microsoft 365, AuditReady';
const description =
  'Scegli da dove partire: processi e Microsoft 365, AuditReady o entrambi. Lascia i tuoi riferimenti e Devisia ti risponde con un primo passo chiaro.';

const processiTags = [
  'Processi e integrazioni',
  'Microsoft 365',
  'Copilot e AI governata',
  'Software su misura',
];
const processiFlow = ['Capire', 'Progettare', 'Costruire', 'Verificare'];
const auditTags = ['GDPR', 'NIS2', 'DORA', 'AI Act', 'Whistleblowing', 'Modello 231'];
const auditFlow = ['Richiesta', 'Owner', 'Evidenza', 'Verifica', 'Export'];
---

<Layout
  title="Processi e Microsoft 365, AuditReady"
  documentTitle={documentTitle}
  description={description}
  canonical={PAGE_PATH}
  lang="it"
  alternatePaths={{ it: PAGE_PATH, xDefault: PAGE_PATH }}
  containMain={false}
  minimalChrome={true}
  showChatWidget={false}
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <Fragment slot="header-actions">
    <a
      class="nav-landing-contact"
      href={PHONE_HREF}
      aria-label={`Chiama Devisia allo ${PHONE_NUMBER}`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.64a2 2 0 0 1-.45 2.11L8 9.75a16 16 0 0 0 6 6l1.28-1.28a2 2 0 0 1 2.11-.45c.86.29 1.74.5 2.64.62A2 2 0 0 1 22 16.92Z"
        ></path>
      </svg>
      <span class="nav-landing-contact__label">{PHONE_NUMBER}</span>
    </a>
  </Fragment>

  <div class="bro" data-brochure>
    <section class="bro-hero" aria-labelledby="bro-title">
      <svg
        class="bro-hero__mesh"
        viewBox="0 0 640 420"
        aria-hidden="true"
        focusable="false"
        preserveAspectRatio="xMaxYMid slice"
      >
        <g fill="none" stroke-linecap="round">
          <path d="M20 330 C140 250 200 340 320 250 S520 170 630 60" stroke="#009ce0" stroke-opacity=".5" stroke-width="1.5"></path>
          <path d="M0 250 C120 190 220 260 330 180 S520 120 640 10" stroke="#e42478" stroke-opacity=".45" stroke-width="1.5"></path>
          <path d="M60 410 C170 330 260 390 380 300 S560 260 640 170" stroke="#3868b0" stroke-opacity=".7" stroke-width="1.5"></path>
          <path d="M320 250 L330 180 L380 300 L320 250 M330 180 L440 210 L380 300" stroke="#009ce0" stroke-opacity=".28" stroke-width="1"></path>
        </g>
        <g>
          <circle cx="320" cy="250" r="4.5" fill="#009ce0"></circle>
          <circle cx="330" cy="180" r="4.5" fill="#e42478"></circle>
          <circle cx="380" cy="300" r="4.5" fill="#3868b0"></circle>
          <circle cx="440" cy="210" r="3.5" fill="#009ce0" fill-opacity=".8"></circle>
          <circle cx="520" cy="170" r="3.5" fill="#e42478" fill-opacity=".8"></circle>
          <circle cx="200" cy="340" r="3" fill="#33b4ef" fill-opacity=".7"></circle>
          <circle cx="600" cy="90" r="3" fill="#ff5c9e" fill-opacity=".8"></circle>
        </g>
      </svg>

      <div class="bro-hero__inner">
        <p class="bro-eyebrow">Devisia · Trieste</p>
        <h1 id="bro-title" class="bro-title">
          Due modi di mettere ordine. <span>Scegli il tuo.</span>
        </h1>
        <p class="bro-lede">
          Processi e Microsoft 365, AuditReady, oppure entrambi. Dicci da dove partire e ti
          rispondiamo con un primo passo chiaro.
        </p>
      </div>
    </section>

    <section class="bro-form" aria-labelledby="bro-form-title">
      <div class="bro-form__inner">
        <header class="bro-form__head">
          <h2 id="bro-form-title">Da dove vuoi partire?</h2>
          <p>Scegli una o entrambe le aree, poi lasciaci i tuoi riferimenti.</p>
        </header>

        <ContactForm
          lang="it"
          showHeading={false}
          fieldIdPrefix="brochure-"
          source={LANDING_SOURCE}
          trackingSource={LANDING_SOURCE}
          formId="landing-brochure"
          pagePath={PAGE_PATH}
          variant="landing"
          submitLabel="Invia la richiesta"
        >
          <fieldset
            slot="fields-extra"
            class="bro-choice"
            data-choice
            data-field="interest"
            aria-describedby="brochure-interest-error"
          >
            <legend class="bro-choice__legend">Area di interesse, una o entrambe *</legend>

            <div class="bro-choice__grid">
              <label class="bro-card bro-card--processi">
                <input
                  class="bro-card__input"
                  type="checkbox"
                  name="interest_processi"
                  value="true"
                />
                <span class="bro-card__top">
                  <span class="bro-card__eyebrow">01 · Processi</span>
                  <span class="bro-card__state" aria-hidden="true">
                    <span class="bro-card__box">
                      <svg viewBox="0 0 16 16" focusable="false">
                        <path d="M3.2 8.4 6.6 11.6 12.8 4.6"></path>
                      </svg>
                    </span>
                    <span class="bro-card__state-text bro-card__state-text--off">Scegli</span>
                    <span class="bro-card__state-text bro-card__state-text--on">Scelto</span>
                  </span>
                </span>
                <span class="bro-card__title">Processi e Microsoft 365</span>
                <span class="bro-card__text">
                  Prima rendiamo leggibile il processo. Poi costruiamo il sistema.
                </span>
                <ul class="bro-card__tags" aria-label="Cosa include">
                  {processiTags.map((tag) => <li>{tag}</li>)}
                </ul>
                <span class="bro-card__flow" aria-label={`Metodo: ${processiFlow.join(', ')}`}>
                  {
                    processiFlow.map((step, index) => (
                      <span aria-hidden="true">
                        {index > 0 && <i>→</i>}
                        {step}
                      </span>
                    ))
                  }
                </span>
              </label>

              <label class="bro-card bro-card--audit">
                <input
                  class="bro-card__input"
                  type="checkbox"
                  name="interest_auditready"
                  value="true"
                />
                <span class="bro-card__top">
                  <span class="bro-card__eyebrow">02 · AuditReady</span>
                  <span class="bro-card__state" aria-hidden="true">
                    <span class="bro-card__box">
                      <svg viewBox="0 0 16 16" focusable="false">
                        <path d="M3.2 8.4 6.6 11.6 12.8 4.6"></path>
                      </svg>
                    </span>
                    <span class="bro-card__state-text bro-card__state-text--off">Scegli</span>
                    <span class="bro-card__state-text bro-card__state-text--on">Scelto</span>
                  </span>
                </span>
                <span class="bro-card__title">AuditReady</span>
                <span class="bro-card__text">
                  Un unico ambiente per audit, evidenze, rischi e governance: requisiti,
                  controlli, responsabili e azioni correttive nello stesso posto.
                </span>
                <ul class="bro-card__tags" aria-label="Framework coperti">
                  {auditTags.map((tag) => <li>{tag}</li>)}
                </ul>
                <span class="bro-card__flow" aria-label={`Flusso: ${auditFlow.join(', ')}`}>
                  {
                    auditFlow.map((step, index) => (
                      <span aria-hidden="true">
                        {index > 0 && <i>→</i>}
                        {step}
                      </span>
                    ))
                  }
                </span>
              </label>
            </div>

            <p class="bro-choice__error" id="brochure-interest-error" data-error-for="interest" hidden></p>
            <p class="bro-choice__note">
              AuditReady organizza le evidenze e non sostituisce la consulenza specialistica.
            </p>
          </fieldset>
        </ContactForm>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { captureUtmFromLocation } from '../lib/utm';
  import { trackLeadEvent } from '../lib/leadTracking';

  const shell = document.querySelector('[data-brochure]');

  if (shell instanceof HTMLElement) {
    captureUtmFromLocation();
    trackLeadEvent({ event: 'landing_view', source: 'landing_brochure', pagePath: '/brochure' });

    const group = shell.querySelector('[data-choice]');
    const error = shell.querySelector('[data-error-for="interest"]');

    if (group instanceof HTMLElement) {
      group.addEventListener('change', () => {
        group.removeAttribute('aria-invalid');
        if (error instanceof HTMLElement) {
          error.hidden = true;
          error.textContent = '';
        }
      });
    }
  }
</script>

<style is:global>
  /* Palette sampled from the printed brochure. Scoped to this page: the stylesheet
     is only shipped with /brochure, and nothing here touches the global tokens. */
  :root {
    --bro-navy: #081020;
    --bro-deep: #182848;
    --bro-cloud: #f4f7fb;
    --bro-line: #cbd5e4;
    --bro-pink: #e42478;
    --bro-pink-soft: #ff5c9e;
    --bro-pink-strong: #b8175a;
    --bro-cyan: #009ce0;
    --bro-cyan-soft: #33b4ef;
    --bro-blue: #2b5397;
    --bro-blue-brand: #3868b0;
    --bro-muted-dark: #b9c6dc;
    --bro-muted-light: #4a5a75;
  }

  /* The header sits outside the page wrapper, so it is themed here to meet the
     navy hero instead of the site's ivory. Unlayered rules beat the layered ones. */
  .site-header {
    background: var(--bro-navy);
    border-bottom-color: color-mix(in oklab, white 14%, transparent);
  }
  .site-header .nav-brand .logo-img--light {
    display: none;
  }
  .site-header .nav-brand .logo-img--dark {
    display: block;
    filter: none;
  }
  .site-header .nav-landing-contact {
    color: #fff;
  }
  .site-header .nav-landing-contact:hover {
    color: var(--bro-pink-soft);
  }
  .site-header .nav-landing-contact:focus-visible {
    outline-color: var(--bro-cyan-soft);
  }
</style>

<style>
  .bro {
    font-family: var(--ds-font-ui);
    background: var(--bro-cloud);
    color: var(--bro-navy);
  }

  /* Hero: the dark half of the brochure */
  .bro-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bro-navy);
    color: #fff;
    border-bottom: 5px solid transparent;
    border-image: linear-gradient(90deg, var(--bro-pink) 0 50%, var(--bro-cyan) 50% 100%) 1;
  }

  .bro-hero__mesh {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0.85;
    pointer-events: none;
  }

  .bro-hero__inner {
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(2.25rem, 6vw, 4.5rem) var(--ds-container-pad) clamp(2.5rem, 6vw, 4.75rem);
  }

  .bro-eyebrow {
    margin: 0 0 1rem;
    color: var(--bro-cyan-soft);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bro-title {
    margin: 0;
    max-width: 16ch;
    font-family: var(--ds-font-ui);
    font-size: clamp(2rem, 1.15rem + 4.6vw, 3.9rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.012em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .bro-title span {
    display: block;
    margin-top: 0.15em;
    color: var(--bro-pink-soft);
  }

  .bro-lede {
    max-width: 36rem;
    margin: 1.4rem 0 0;
    color: var(--bro-muted-dark);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* Form band: the light half. Local tokens retheme the shared form without
     changing the component, and pin it to light regardless of the site theme. */
  .bro-form {
    --ds-color-bg: var(--bro-cloud);
    --ds-color-surface: #fff;
    --ds-color-text: var(--bro-navy);
    --ds-color-text-muted: var(--bro-muted-light);
    --ds-color-primary: var(--bro-pink-strong);
    --ds-color-accent: #c81b64;
    --ds-color-border: var(--bro-line);
    --ds-color-border-strong: #9fb0cb;
    --ds-color-danger: #b3261e;
    --ds-focus-ring: 0 0 0 3px color-mix(in oklch, var(--bro-cyan) 60%, transparent);
    background: var(--bro-cloud);
    color: var(--bro-navy);
    padding: clamp(2.25rem, 6vw, 4.5rem) var(--ds-container-pad) clamp(3rem, 7vw, 5.5rem);
  }

  .bro-form__inner {
    max-width: 62rem;
    margin-inline: auto;
  }

  .bro-form__head {
    margin-bottom: 1.75rem;
  }

  .bro-form__head h2 {
    margin: 0;
    font-family: var(--ds-font-ui);
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .bro-form__head p {
    max-width: 34rem;
    margin: 0.7rem 0 0;
    color: var(--bro-muted-light);
    line-height: 1.55;
  }

  /* Choice cards */
  .bro-choice {
    min-width: 0;
    margin: 0 0 var(--ds-space-5, 1.25rem);
    padding: 0;
    border: 0;
  }

  .bro-choice__legend {
    margin-bottom: 0.75rem;
    padding: 0;
    color: var(--bro-navy);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bro-choice__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }

  .bro-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
    padding: clamp(1.15rem, 3vw, 1.6rem);
    border: 2px solid var(--card-line);
    background: var(--card-bg);
    color: var(--card-text);
    cursor: pointer;
    transition:
      border-color var(--ds-motion-base) var(--ds-ease-standard),
      transform var(--ds-motion-base) var(--ds-ease-standard);
  }

  .bro-card--processi {
    --card-bg: var(--bro-navy);
    --card-text: #fff;
    --card-muted: var(--bro-muted-dark);
    --card-line: var(--bro-deep);
    --card-accent: var(--bro-pink-soft);
    --card-selected: var(--bro-pink);
    --card-tag-bg: var(--bro-deep);
    --card-tag-text: #e6ecf7;
    --card-focus: var(--bro-cyan-soft);
  }

  .bro-card--audit {
    --card-bg: #fff;
    --card-text: var(--bro-navy);
    --card-muted: var(--bro-muted-light);
    --card-line: var(--bro-line);
    --card-accent: var(--bro-blue);
    --card-selected: var(--bro-blue);
    --card-tag-bg: #e8eef8;
    --card-tag-text: var(--bro-navy);
    --card-focus: var(--bro-blue);
  }

  .bro-card:hover {
    border-color: var(--card-selected);
  }

  .bro-card:has(.bro-card__input:checked) {
    border-color: var(--card-selected);
    box-shadow: inset 0 0 0 1px var(--card-selected);
  }

  .bro-card:has(.bro-card__input:focus-visible) {
    outline: 3px solid var(--card-focus);
    outline-offset: 3px;
  }

  .bro-choice[aria-invalid='true'] .bro-card {
    border-color: var(--ds-color-danger);
  }

  /* The real checkbox covers the whole card, so the card is one large touch target
     that stays reachable and announced by keyboard and screen readers. */
  .bro-card__input {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .bro-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .bro-card__eyebrow {
    color: var(--card-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bro-card__state {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--card-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .bro-card__box {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 2px solid var(--card-muted);
    background: transparent;
  }

  .bro-card__box svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
  }

  .bro-card:has(.bro-card__input:checked) .bro-card__box {
    border-color: var(--card-selected);
    background: var(--card-selected);
  }

  .bro-card:has(.bro-card__input:checked) .bro-card__box svg {
    opacity: 1;
  }

  .bro-card:has(.bro-card__input:checked) .bro-card__state {
    color: var(--card-text);
  }

  .bro-card__state-text--on,
  .bro-card:has(.bro-card__input:checked) .bro-card__state-text--off {
    display: none;
  }

  .bro-card:has(.bro-card__input:checked) .bro-card__state-text--on {
    display: inline;
  }

  .bro-card__title {
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 1.8rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .bro-card__text {
    color: var(--card-muted);
    font-size: 1rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .bro-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bro-card__tags li {
    padding: 0.32rem 0.6rem;
    background: var(--card-tag-bg);
    color: var(--card-tag-text);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .bro-card__flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in oklch, var(--card-muted) 40%, transparent);
    color: var(--card-accent);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bro-card__flow i {
    margin-right: 0.5rem;
    color: var(--card-muted);
    font-style: normal;
  }

  .bro-choice__error {
    margin: 0.75rem 0 0;
    color: var(--ds-color-danger);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .bro-choice__error[hidden] {
    display: none;
  }

  .bro-choice__note {
    margin: 0.85rem 0 0;
    color: var(--bro-muted-light);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .bro-hero__inner {
      padding-block: clamp(3.5rem, 7vw, 5.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bro-card {
      transition: none;
    }
  }
</style>
