---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import EditorialCTA from '../../components/site/EditorialCTA.astro';
import { breadcrumbListJsonLd } from '../../lib/seo/structuredData';

const description =
  'AI integration for businesses with AI governance, privacy, AI security, human-in-the-loop, logging, audit trail and validation.';

const site = Astro.site ?? new URL('https://devisia.pro');
const breadcrumbs = breadcrumbListJsonLd({
  site,
  items: [
    { name: 'Home', url: '/en' },
    { name: 'Governed AI', url: '/en/governed-ai' },
  ],
});
---

<Layout
  lang="en"
  title="Governed AI"
  documentTitle="Governed AI for organisations | Devisia"
  description={description}
  structuredData={[breadcrumbs]}
>
  <PageIntro
    eyebrow="Sheet · Governed AI"
    h1="AI in production inside verifiable perimeters and guardrails"
    lede="We design assistants, agents, RAG systems and workflows with explicit boundaries, human oversight, data policies and traceable outputs."
  />

  <section class="ds-stack ds-reading" data-gap="lg" style="margin-bottom: var(--ds-space-8)">
    <h2>From prototype to production</h2>
    <p>
      A prototype only needs to show that a model can answer. Production requires control over latency, cost, failure modes, abuse, data access rights and what happens when an output is unacceptable.
    </p>

    <h2>Responsible AI treats LLMs as probabilistic systems</h2>
    <p>We place clear boundaries around models, verify material outputs and keep humans in the loop wherever accountability must remain with people.</p>

    <h2>What we integrate</h2>
    <p>We build and connect chatbots, agents, RAG pipelines, orchestration, MCP servers and workflow automation, backed by a clear matrix for data scope, permissions, retention and logging.</p>

    <h2>AI security controls</h2>
    <p>We implement human-in-the-loop checkpoints, instrumentation policies, prompt versioning, audit trails, output sampling, safe fallbacks and data minimisation integrated with your existing identity systems.</p>
    <p>Useful tools: <a href="/en/tools/ai-risk-checklist">AI risk &amp; privacy checklist</a> and <a href="/en/ai-structure">AI Structure</a>.</p>
  </section>

  <EditorialCTA
    variant="tint"
    title="Bring AI into your workflows while keeping operational control"
    ctaLabel="Design a controlled AI use case"
    ctaHref="/en/contact"
    copy="Share scope, data, users, limits and what your organisation needs as proof. We define together what can be automated, what stays under human review and how to trace operations."
  />
</Layout>
