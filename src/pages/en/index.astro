---
import { AUDITREADY_SITE_URL } from '../../lib/auditready';
import Layout from '../../layouts/Layout.astro';
import ProcessSheet from '../../components/site/ProcessSheet.astro';
import EditorialCTA from '../../components/site/EditorialCTA.astro';
import HomeChatSection from '../../components/site/HomeChatSection.astro';
import { breadcrumbListJsonLd } from '../../lib/seo/structuredData';

const title = 'Home';
const description =
  'Custom software, governed AI and operational compliance: three flows, one readable system, clear guardrails and verifiable evidence.';

const site = Astro.site ?? new URL('https://devisia.pro');
const breadcrumbs = breadcrumbListJsonLd({
  site,
  items: [{ name: 'Home', url: '/en' }],
});
---

<Layout
  title={title}
  documentTitle="Devisia | Governed software, AI and compliance"
  description={description}
  structuredData={[breadcrumbs]}
  lang="en"
  containMain={false}
>
  <ProcessSheet lang="en" />

  <section class="ds-container sheet-section" aria-labelledby="home-prob">
    <p class="sheet-section__kicker">Starting anomaly</p>
    <h2 id="home-prob" class="site-h2">Automating an opaque flow does not govern it — it accelerates it</h2>
    <p class="site-lead">
      When roles, data and constraints stay implicit, every integration — software or AI — multiplies exceptions and debt.
      We make the process readable first; then we build what sustains it.
    </p>
  </section>

  <section class="site-section site-section--tint" aria-labelledby="home-three">
    <section class="ds-container">
      <p class="sheet-section__kicker">Three process lines</p>
      <h2 id="home-three" class="site-h2">One sheet, three flows, one system</h2>
      <p class="site-lead">
        Not disconnected modules: Software, governed AI and compliance converge on the same schema, with guardrails and proof on every critical step.
      </p>
      <section class="sheet-rail">
        <article class="sheet-rail__item">
          <span class="sheet-rail__tag">TAG · SW</span>
          <h3>Custom software</h3>
          <p>Platforms that last, integrate and stay maintainable — decisions grounded in evidence, not assumptions.</p>
        </article>
        <article class="sheet-rail__item">
          <span class="sheet-rail__tag">TAG · AI</span>
          <h3>Governed AI</h3>
          <p>Assistants, RAG and workflows only where boundaries, logging, validation, human oversight and named accountability exist.</p>
        </article>
        <article class="sheet-rail__item">
          <span class="sheet-rail__tag">TAG · CP</span>
          <h3>Operational compliance</h3>
          <p>Not decorative policy: the ongoing ability to show who did what, when, and with which evidence.</p>
        </article>
      </section>
    </section>
  </section>

  <section class="ds-container sheet-section" aria-labelledby="home-proof">
    <p class="sheet-section__kicker">Evidence chain</p>
    <h2 id="home-proof" class="site-h2">From real work to exportable proof</h2>
    <p class="site-lead">
      Every guardrail must leave a trail. Find where risk starts, set boundaries, make each decision readable when it must be proven.
    </p>
    <ol class="sheet-chain">
      <li>
        <span class="sheet-rail__tag">Method</span>
        <h3>Process first</h3>
        <p>We interview operators, exceptions and unwritten rules before choosing stack, automation or models.</p>
        <a class="ds-link" data-variant="muted" href="/en/method">How we work <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <span class="sheet-rail__tag">AI</span>
        <h3>Models inside perimeters</h3>
        <p>Production needs limits, logs, validation, policy and named human accountability.</p>
        <a class="ds-link" data-variant="muted" href="/en/governed-ai">Governed AI <span aria-hidden="true">→</span></a>
      </li>
      <li>
        <span class="sheet-rail__tag">Compliance</span>
        <h3>Intent is not enough</h3>
        <p>GDPR, NIS2, DORA and ISO 27001 hold when every control produces readable evidence.</p>
        <a class="ds-link" data-variant="muted" href="/en/compliance-auditability">Auditability <span aria-hidden="true">→</span></a>
      </li>
    </ol>
  </section>

  <HomeChatSection lang="en" />

  <section class="ds-container sheet-section" aria-labelledby="home-ar">
    <section class="sheet-titleblock">
      <p class="sheet-section__kicker">Product · AuditReady</p>
      <h2 id="home-ar" class="site-h2">When control becomes proof</h2>
      <p class="site-lead" style="margin:0">
        Collects, orders, validates and exports evidence for audit and security. Assisted AI where useful; human oversight always present.
      </p>
      <p>
        <a
          class="ds-btn"
          data-variant="primary"
          data-size="lg"
          href={AUDITREADY_SITE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open AuditReady
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </p>
    </section>
  </section>

  <section class="ds-container sheet-section" aria-labelledby="home-why">
    <p class="sheet-section__kicker">Sheet criteria</p>
    <h2 id="home-why" class="site-h2">Less noise. More schema</h2>
    <ul class="site-list-check">
      <li>We start from the process, not a technology catalogue.</li>
      <li>We make constraints, data, roles and accountability explicit.</li>
      <li>We build software that stays readable and traceable over time.</li>
      <li>We treat AI and compliance as schema choices, not add-ons.</li>
      <li>We favour controlled releases and verifiable evidence.</li>
    </ul>
  </section>

  <EditorialCTA
    headingId="home-editorial-cta"
    title="If the system must hold, we start from what it must prove"
    copy="Tell us about process, data, risks, constraints and people involved. The first goal is to align context, guardrails and success criteria — not to sell a ready-made package."
    ctaLabel="Start a conversation"
    ctaHref="/en/contact"
  />
</Layout>
