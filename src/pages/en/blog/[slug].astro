---
import Layout from '../../../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { blogPostingJsonLd, breadcrumbListJsonLd } from '../../../lib/seo/structuredData';
import { Image } from 'astro:assets';

const slug = Astro.params.slug;
if (!slug) {
  throw new Response(null, { status: 404, statusText: 'Not found' });
}

const entry: CollectionEntry<'blogEn'> | undefined = await getEntry('blogEn', `en/${slug}`);
if (!entry) {
  throw new Response(null, { status: 404, statusText: 'Not found' });
}

const { Content } = await render(entry);
const site = Astro.site ?? new URL('https://devisia.pro');
const pageUrl = new URL(`/en/blog/${slug}/`, site).toString();
const published =
  entry.data.pubDate instanceof Date ? entry.data.pubDate.toISOString() : new Date(entry.data.pubDate).toISOString();

let languageSwitchHref: string | undefined;
if (entry.data.translationSlug) {
  const itEntry = await getEntry('blogIt', `it/${entry.data.translationSlug}`);
  if (itEntry) {
    languageSwitchHref = `/blog/${entry.data.translationSlug}`;
  }
}

const breadcrumbs = breadcrumbListJsonLd({
  site,
  items: [
    { name: 'Home', url: '/en/' },
    { name: 'Blog', url: '/en/blog' },
    { name: entry.data.title, url: `/en/blog/${slug}` },
  ],
});

const blogPosting = blogPostingJsonLd({
  site,
  lang: 'en',
  url: pageUrl,
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: published,
  authorName: entry.data.author,
  image: entry.data.heroImage,
});

const formatDate = (date: Date | string): string => {
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  heroImage={entry.data.heroImage}
  lang="en"
  structuredData={[breadcrumbs, blogPosting]}
  languageSwitchHref={languageSwitchHref}
>
  <article class="blog-post">
    <header class="post-header">
      <section class="post-meta">
        <time datetime={entry.data.pubDate.toString()}>{formatDate(entry.data.pubDate)}</time>
        <span class="separator">·</span>
        <span class="post-author">by {entry.data.author}</span>
      </section>

      <h1 class="post-title">{entry.data.title}</h1>
      <p class="post-description">{entry.data.description}</p>

      {entry.data.tags && entry.data.tags.length > 0 && (
        <section class="post-tags">
          {entry.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </section>
      )}

      {entry.data.heroImage && (
        <section class="post-hero-image">
          <Image 
            src={entry.data.heroImage} 
            alt={entry.data.title} 
            width={800}
            height={400}
            widths={[320, 480, 540, 640, 800, 1200]}
            sizes="(max-width: 48rem) 98vw, 90vw"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </section>
      )}
    </header>

    <section class="post-content">
      <Content />
    </section>

    <footer class="post-footer">
      <a href="/en/blog" class="back-link">← Back to Blog</a>
    </footer>
  </article>
</Layout>

