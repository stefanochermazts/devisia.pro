---
import { AUDITREADY_SITE_URL } from '../../lib/auditready';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import EditorialCTA from '../../components/site/EditorialCTA.astro';
import { breadcrumbListJsonLd } from '../../lib/seo/structuredData';

const description =
  'Operational compliance for GDPR, NIS2, DORA and ISO 27001: evidence, assets, suppliers, processes, AI security and traceability.';

const documentTitle = 'Digital compliance and auditability | Devisia';

const site = Astro.site ?? new URL('https://devisia.pro');
const breadcrumbs = breadcrumbListJsonLd({
  site,
  items: [
    { name: 'Home', url: '/en' },
    { name: 'Compliance and auditability', url: '/en/compliance-auditability' },
  ],
});
---

<Layout
  lang="en"
  title="Compliance and auditability"
  documentTitle={documentTitle}
  description={description}
  structuredData={[breadcrumbs]}
>
  <PageIntro
    eyebrow="Sheet · Compliance"
    h1="Operational compliance: traceable evidence built into daily workflows"
    lede="We design flows where controls, logs, assignments and exports match what you must demonstrate during an audit or after an incident, with clear accountability on every step."
  />

  <section class="ds-stack ds-reading" data-gap="lg" style="margin-bottom: var(--ds-space-8)">
    <h2>The real problem</h2>
    <p>
      In regulated environments the underlying controls often exist, yet artefacts remain <strong>scattered, unversioned or hard to retrieve</strong> in the format and timeframe required. Solving this requires better operational workflows rather than last-minute document collection.
    </p>

    <h2>Frameworks, governance and AI security in one system</h2>
    <p>We help teams structure evidence collection, asset and dependency inventories, supplier oversight, operational roles, export packs and business continuity across GDPR, NIS2, DORA and ISO 27001.</p>

    <h2>AuditReady</h2>
    <p>
      <a href={AUDITREADY_SITE_URL} target="_blank" rel="noopener noreferrer">AuditReady</a> is a Devisia product built to collect, link and package evidence with full traceability.
      It streamlines operational preparation while working alongside your DPO, legal counsel and external auditors.
    </p>
  </section>

  <EditorialCTA
    title="Align tools, controls and evidence with how you actually work"
    ctaLabel="Discuss the evidence you need"
    ctaHref="/en/contact"
    copy="We start from what you are asked for today, who is accountable, and where proofs live now. Then we propose operational tools and steps."
  />
</Layout>
