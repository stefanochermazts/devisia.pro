---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import EditorialCTA from '../../components/site/EditorialCTA.astro';
import { breadcrumbListJsonLd } from '../../lib/seo/structuredData';

const description =
  'Devisia designs and builds governable digital systems: custom software, AI with a clear perimeter, and operational compliance with evidence.';

const site = Astro.site ?? new URL('https://devisia.pro');
const breadcrumbs = breadcrumbListJsonLd({
  site,
  items: [
    { name: 'Home', url: '/en' },
    { name: 'About', url: '/en/about' },
  ],
});
---

<Layout lang="en" title="About Devisia: partner for governable systems" description={description} structuredData={[breadcrumbs]}>
  <PageIntro
    eyebrow="Sheet · About"
    h1="The partner that brings order before accelerating"
    lede="Devisia joins custom software, governed AI and operational compliance for teams that already have something to lose: continuity, reputation, data, audit."
  />

  <section class="ds-stack ds-reading" data-gap="lg" style="margin-bottom: var(--ds-space-8)">
    <h2>Why we exist</h2>
    <p>
      So “digital” does not become a fragile stack, buried requirements, models without criteria, or
      scattered evidence when you must prove something. We put process, boundaries and proof on the
      sheet — then we build.
    </p>

    <h2>Problems we tackle</h2>
    <ul>
      <li>Processes and data misaligned across units, systems and suppliers.</li>
      <li>Software grown by accretion, opaque to operators and auditors.</li>
      <li>AI introduced where perimeter, validation or trail are missing.</li>
      <li>Compliance asks unsupported by tools, logs, exports and ownership.</li>
    </ul>

    <h2>How we think</h2>
    <p>Schema and accountability first; code and automation once guardrails are clear. Evidence, not theatre.</p>

    <h2>Products</h2>
    <p>
      We ship <a href="/en/products">vertical products</a> when the best fix is to make operational
      what otherwise stays in spreadsheets: order, export, tracking.
    </p>

    <h2>What we are not</h2>
    <p>
      Not a generic full-service agency, not a slide vendor. If you want transformation without
      touching process, we are misaligned.
    </p>
  </section>

  <EditorialCTA
    variant="tint"
    title="If the next constraint is serious, treat it with competence"
    ctaLabel="Share your context"
    ctaHref="/en/contact"
    copy="First contact: facts, constraints, ownership and acceptance criteria — without forcing a stack or vendor."
  />
</Layout>
