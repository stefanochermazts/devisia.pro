---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbListJsonLd } from '../../lib/seo/structuredData';

// Get all blog posts
const allPosts = await getCollection('blogIt');
const slugFromId = (id: string) => id.replace(/^(it|en)\//, '');
const PAGE_SIZE = 8;

// Sort posts by publication date (newest first)
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const initialPosts = sortedPosts.slice(0, PAGE_SIZE);

const formatDate = (date: Date | string): string => {
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toLocaleDateString('it-IT', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const site = Astro.site ?? new URL('https://devisia.pro');
const breadcrumbs = breadcrumbListJsonLd({
  site,
  items: [
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
  ],
});
---

<Layout 
  title="Approfondimenti su software su misura e AI" 
  description="Approfondimenti, tutorial e aggiornamenti Devisia su tecnologia, sviluppo software e trasformazione digitale."
  structuredData={[breadcrumbs]}
>
  <section class="blog-container">
    <header class="blog-header">
      <h1>Blog</h1>
      <p class="blog-intro">
        Approfondimenti, tutorial e aggiornamenti su tecnologia, sviluppo software e trasformazione digitale.
      </p>
    </header>
    
    {sortedPosts.length === 0 ? (
      <section class="no-posts">
        <p>Nessun articolo pubblicato. Torna presto!</p>
      </section>
    ) : (
      <>
        <section
          class="posts-grid"
          id="posts-grid"
          data-endpoint="/api/blog.json?lang=it"
          data-locale="it-IT"
          data-url-prefix="/blog"
          data-read-more-label="Leggi →"
          data-author-prefix="di "
          data-offset={initialPosts.length}
          data-total={sortedPosts.length}
          data-page-size={PAGE_SIZE}
        >
          {initialPosts.map((post) => (
            <article class="post-card">
              {post.data.heroImage && (
                <section class="post-image">
                  <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
                </section>
              )}

              <section class="post-content">
                <section class="post-meta">
                  <time datetime={post.data.pubDate.toString()}>{formatDate(post.data.pubDate)}</time>
                  <span class="post-author">di {post.data.author}</span>
                </section>

                <h2 class="post-title">
                  <a href={`/blog/${slugFromId(post.id)}`}>{post.data.title}</a>
                </h2>

                <p class="post-description">{post.data.description}</p>

                {post.data.tags && post.data.tags.length > 0 && (
                  <section class="post-tags">
                    {post.data.tags.map((tag: string) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </section>
                )}

              </section>
            </article>
          ))}
        </section>

        {sortedPosts.length > PAGE_SIZE && (
          <section class="load-more-wrap" aria-label="Caricamento articoli">
            <p id="posts-status" class="load-status" aria-live="polite"></p>
            <button id="load-more" class="load-more" type="button">
              Carica altri
            </button>
            <section id="posts-sentinel" class="load-sentinel" aria-hidden="true"></section>
          </section>
        )}
      </>
    )}

    <section class="page-intro" aria-label="Introduzione al blog">
      <details class="intro-details">
        <summary class="intro-summary">
          <span class="intro-summary-title">Cosa trovi qui</span>
          <svg class="intro-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <section class="intro-body">
          <h2 class="intro-title">Cosa trovi qui</h2>
          <p class="intro-text">
            Questo blog nasce per condividere in modo concreto come ragioniamo quando progettiamo e realizziamo software:
            dal primo workshop con gli stakeholder fino al rilascio in produzione e al miglioramento continuo. Non è un
            semplice diario di novità: troverai guide operative, esempi, checklist e “decisioni di architettura”
            spiegate con un linguaggio chiaro, anche quando il tema è tecnico. L’obiettivo è aiutarti a fare scelte più
            solide, riducendo rischi e costi nascosti, e aumentando la probabilità di ottenere un prodotto che funzioni
            davvero nel mondo reale.
          </p>
          <p class="intro-text">
            Pubblicheremo contenuti su sviluppo web e backend, integrazioni con API, automazioni, AI applicata ai processi,
            qualità (testing, osservabilità), sicurezza e privacy (GDPR incluso). Quando parliamo di AI, lo facciamo con un
            approccio pragmatico: definire bene il problema, misurare il valore, mettere guardrail e governare i fornitori.
            Se ti interessa questo tema, dai un’occhiata anche alla nostra
            <a class="intro-link" href="/tools/ai-risk-checklist">AI Risk &amp; Privacy Checklist</a>.
          </p>

          <section class="intro-grid" role="list">
            <article class="intro-item" role="listitem">
              <h3 class="intro-item-title">Per chi è</h3>
              <p class="intro-item-text">
                Founder, product manager, team tech e persone non tecniche che devono prendere decisioni informate:
                scope, roadmap, costi, scelte “buy vs build”, e cosa chiedere davvero a un fornitore o a un team interno.
              </p>
            </article>
            <article class="intro-item" role="listitem">
              <h3 class="intro-item-title">Come leggere gli articoli</h3>
              <p class="intro-item-text">
                Ogni post cerca di rispondere a una domanda reale (es. “Come evito lock-in?”, “Come valido un MVP?”,
                “Quali metriche contano?”) e termina con azioni pratiche. Se vuoi un confronto diretto, puoi
                <a class="intro-link" href="/contatti">contattarci qui</a>.
              </p>
            </article>
            <article class="intro-item" role="listitem">
              <h3 class="intro-item-title">Temi ricorrenti</h3>
              <ul class="intro-list">
                <li><strong>Architettura &amp; scalabilità</strong>: scelte semplici, evolutive, misurabili.</li>
                <li><strong>Qualità</strong>: test, code review, CI/CD e riduzione del debito tecnico.</li>
                <li><strong>AI responsabile</strong>: valutazione rischi, privacy, logging e controlli.</li>
                <li><strong>Delivery</strong>: rilasci piccoli, feedback rapidi, obiettivi chiari.</li>
              </ul>
            </article>
            <article class="intro-item" role="listitem">
              <h3 class="intro-item-title">Domande frequenti</h3>
              <p class="intro-item-text">
                <strong>Quanto spesso pubblicate?</strong> Preferiamo qualità e utilità: pubblichiamo quando abbiamo
                qualcosa che può davvero aiutarti (una guida, un pattern, una checklist).
              </p>
              <p class="intro-item-text">
                <strong>Posso proporre un tema?</strong> Sì: scrivici cosa stai cercando di risolvere e quali vincoli hai.
                Valuteremo se farne un articolo o risponderti direttamente.
              </p>
            </article>
          </section>

          <p class="intro-text intro-cta">
            Vuoi vedere cosa stiamo costruendo? Passa alla pagina
            <a class="intro-link" href="/projects">Progetti</a> per esplorare prodotti, sperimentazioni e iniziative in corso.
          </p>
        </section>
      </details>
    </section>
  </section>
</Layout>

<script is:inline>
  (() => {
    const grid = document.getElementById('posts-grid');
    if (!grid) return;

    const endpointBase = grid.dataset.endpoint;
    const locale = grid.dataset.locale || 'it-IT';
    const urlPrefix = grid.dataset.urlPrefix || '/blog';
    const readMoreLabel = grid.dataset.readMoreLabel || 'Leggi →';
    const authorPrefix = grid.dataset.authorPrefix || 'di ';

    const statusEl = document.getElementById('posts-status');
    const buttonEl = document.getElementById('load-more');
    const sentinelEl = document.getElementById('posts-sentinel');

    const pageSize = Number.parseInt(grid.dataset.pageSize || '8', 10) || 8;
    const total = Number.parseInt(grid.dataset.total || '0', 10) || 0;
    let offset = Number.parseInt(grid.dataset.offset || '0', 10) || 0;

    if (!endpointBase || !buttonEl || !sentinelEl || total <= offset) {
      if (buttonEl) buttonEl.hidden = true;
      if (sentinelEl) sentinelEl.hidden = true;
      return;
    }

    const dateFormatter = new Intl.DateTimeFormat(locale, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });

    const setStatus = (msg) => {
      if (!statusEl) return;
      statusEl.textContent = msg || '';
    };

    const mk = (tag, className) => {
      const el = document.createElement(tag);
      if (className) el.className = className;
      return el;
    };

    const renderPostCard = (post) => {
      const article = mk('article', 'post-card');

      if (post.heroImage) {
        const imgWrap = mk('section', 'post-image');
        const img = document.createElement('img');
        img.loading = 'lazy';
        img.src = post.heroImage;
        img.alt = post.title;
        imgWrap.appendChild(img);
        article.appendChild(imgWrap);
      }

      const content = mk('section', 'post-content');

      const meta = mk('section', 'post-meta');
      const time = document.createElement('time');
      time.dateTime = post.pubDate;
      time.textContent = dateFormatter.format(new Date(post.pubDate));
      meta.appendChild(time);

      const author = mk('span', 'post-author');
      author.textContent = `${authorPrefix}${post.author}`;
      meta.appendChild(author);
      content.appendChild(meta);

      const title = mk('h2', 'post-title');
      const link = document.createElement('a');
      link.href = `${urlPrefix}/${post.slug}`;
      link.textContent = post.title;
      title.appendChild(link);
      content.appendChild(title);

      const desc = mk('p', 'post-description');
      desc.textContent = post.description;
      content.appendChild(desc);

      if (Array.isArray(post.tags) && post.tags.length > 0) {
        const tagsWrap = mk('section', 'post-tags');
        for (const t of post.tags) {
          const tag = mk('span', 'tag');
          tag.textContent = String(t);
          tagsWrap.appendChild(tag);
        }
        content.appendChild(tagsWrap);
      }

      const readMore = document.createElement('a');
      readMore.href = `${urlPrefix}/${post.slug}`;
      readMore.className = 'read-more';
      readMore.textContent = readMoreLabel;
      content.appendChild(readMore);

      article.appendChild(content);
      return article;
    };

    let loading = false;
    let done = false;

    const loadMore = async () => {
      if (loading || done) return;
      loading = true;
      buttonEl.disabled = true;
      buttonEl.setAttribute('aria-busy', 'true');
      setStatus('Caricamento…');

      try {
        const res = await fetch(`${endpointBase}&offset=${offset}&limit=${pageSize}`, {
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const data = await res.json();
        const posts = Array.isArray(data.posts) ? data.posts : [];

        for (const p of posts) {
          grid.appendChild(renderPostCard(p));
        }

        offset =
          Number.parseInt(String(data.nextOffset ?? offset + posts.length), 10) ||
          offset + posts.length;
        done = !data.hasMore || offset >= total || posts.length === 0;

        if (done) {
          setStatus('');
          buttonEl.hidden = true;
          sentinelEl.hidden = true;
        } else {
          setStatus('');
          buttonEl.disabled = false;
        }
      } catch (err) {
        // Keep the button as manual fallback.
        setStatus('Impossibile caricare altri articoli. Riprova.');
        buttonEl.disabled = false;
      } finally {
        loading = false;
        buttonEl.removeAttribute('aria-busy');
      }
    };

    buttonEl.addEventListener('click', () => void loadMore());

    if ('IntersectionObserver' in window) {
      buttonEl.hidden = true;
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) void loadMore();
          }
        },
        { rootMargin: '600px 0px' }
      );
      io.observe(sentinelEl);
    }
  })();
</script>
