      bottom: 0;
      /* Above page content, below the sticky header (50) and far below any
         consent dialog, so the cookie banner always wins. */
      z-index: 45;
      padding: 0.7rem clamp(0.85rem, 4vw, 1.5rem);
      padding-bottom: calc(0.7rem + env(safe-area-inset-bottom, 0px));
      border-top: 1px solid var(--ds-color-border-strong);
      background: var(--ds-color-bg);
      box-shadow: 0 -8px 24px color-mix(in oklch, var(--ds-color-text) 12%, transparent);
