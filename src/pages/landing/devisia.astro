    /* Dark, dramatic sections bleed edge-to-edge again: the background spans the
       full viewport via negative margins, while the inner .ds-container is held
       to the left content lane (padding recreates the column boundary), so text
       never sits under the sticky form. */
    .ads-landing .ads-hero,
    .ads-landing .ads-services,
    .ads-landing .ads-method {
      margin-left: calc(-1 * var(--ads-edge));
      margin-right: calc(-1 * (var(--ads-edge) + var(--ads-gap) + var(--ads-rail)));
      padding-left: var(--ads-edge);
      padding-right: calc(var(--ads-edge) + var(--ads-gap) + var(--ads-rail));
    }

    .ads-hero {
      padding-top: var(--ds-hero-padding-top-dense);
