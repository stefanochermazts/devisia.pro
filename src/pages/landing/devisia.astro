---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
import ContactForm from '../../components/site/ContactForm.astro';
import GoogleAdsLeadConversion from '../../components/site/GoogleAdsLeadConversion.astro';
import { resolveDevisiaHero } from '../../data/landing/devisiaHero';
import { breadcrumbListJsonLd } from '../../lib/seo/structuredData';

const documentTitle = 'Devisia | Software, AI e automazioni per le imprese del FVG';
const description =
  'Devisia progetta software, integrazioni, automazioni e sistemi AI governabili per le imprese del Friuli Venezia Giulia.';

const LANDING_SOURCE = 'landing_devisia';
const LANDING_PATH = '/landing/devisia';
const CTA_LABEL = 'Descrivi il tuo processo';
const PHONE_NUMBER = '040 9777468';
const PHONE_HREF = 'tel:+390409777468';

/** Server-resolved from the LinkedIn creative, so the variant ships in the first HTML response. */
const hero = resolveDevisiaHero(Astro.url.searchParams.get('utm_content'));

const interventions = [
  {
    title: 'ERP e Microsoft 365',
    text: 'Collegamento tra sistemi gestionali, SharePoint, documenti e processi approvativi, evitando duplicazioni e passaggi manuali.',
  },
  {
    title: 'Workflow e applicazioni interne',
    text: 'Software e automazioni per sostituire fogli fragili, email non tracciate e attività che dipendono dalla conoscenza di una sola persona.',
  },
  {
    title: 'AI con controllo operativo',
    text: 'Assistenti e funzioni AI integrati nei processi aziendali mantenendo visibili dati, accessi, responsabilità e log.',
  },
];

const m365Layers = [
  { label: 'Documenti', value: 'SharePoint e OneDrive' },
  { label: 'Flussi', value: 'Power Automate' },
  { label: 'Assistenza', value: 'Copilot e AI' },
];

const qualificationSignals = [
  'Hai un processo importante gestito ancora con fogli, email o passaggi manuali.',
  'Vuoi integrare AI o automazioni senza perdere controllo su dati, ruoli e responsabilità.',
  'Devi collegare sistemi esistenti e costruire qualcosa che resti manutenibile nel tempo.',
];

const services = [
  {
    label: '01',
    title: 'Sviluppo software su misura',
    text: 'Applicazioni web, backend e piattaforme interne pensate per reggere l’uso quotidiano: requisiti verificabili, dati coerenti e margine per evolvere dopo il primo rilascio.',
  },
  {
    label: '02',
    title: 'Integrazioni e automazioni',
    text: 'Collegamenti tra gestionali, Microsoft 365, API e servizi esterni, progettati anche per errori ed eccezioni, non solo per il percorso ideale.',
  },
  {
    label: '03',
    title: 'Privacy, tracciabilità e governance',
    text: 'Controllo degli accessi, log delle attività, responsabilità esplicite e auditabilità previsti nell’architettura fin dall’inizio, non aggiunti alla fine.',
  },
];

const methodSteps = [
  'Capire dove il tuo processo perde tempo, dati o controllo.',
  'Definire architettura, flussi dati e responsabilità prima dello sviluppo.',
  'Costruire il sistema in livelli chiari, verificabili e manutenibili.',
  'Integrare l’AI solo dove migliora una decisione o un’attività concreta.',
  'Lasciare visibili privacy, governance e controllo operativo anche dopo il rilascio.',
];

const site = Astro.site ?? new URL('https://devisia.pro');
const isSuccess = Astro.url.searchParams.get('success') === 'true';
const breadcrumbs = breadcrumbListJsonLd({
  site,
  items: [
    { name: 'Home', url: '/' },
    { name: 'Devisia', url: LANDING_PATH },
  ],
});
---

<Layout
  title="Software, AI e automazioni"
  documentTitle={documentTitle}
  description={description}
  canonical={LANDING_PATH}
  lang="it"
  structuredData={[breadcrumbs]}
  alternatePaths={{ it: LANDING_PATH, xDefault: LANDING_PATH }}
  containMain={false}
  minimalChrome={true}
  showChatWidget={false}
>
  {isSuccess && <GoogleAdsLeadConversion slot="head" />}

  <Fragment slot="header-actions">
    <a
      class="nav-landing-contact"
      href={PHONE_HREF}
      aria-label={`Chiama Devisia allo ${PHONE_NUMBER}`}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.64a2 2 0 0 1-.45 2.11L8 9.75a16 16 0 0 0 6 6l1.28-1.28a2 2 0 0 1 2.11-.45c.86.29 1.74.5 2.64.62A2 2 0 0 1 22 16.92Z"
        ></path>
      </svg>
      <span class="nav-landing-contact__label">{PHONE_NUMBER}</span>
    </a>
    <Button href="#ads-form" size="sm" data-ads-form-cta>{CTA_LABEL}</Button>
  </Fragment>

  <div
    class="ads-landing-shell"
    data-ads-landing
    data-landing-source={LANDING_SOURCE}
    data-landing-path={LANDING_PATH}
    data-landing-success={isSuccess ? 'true' : 'false'}
  >
    <div class="ads-landing-shell__main">
      <article class="ads-landing">
        <section class="ads-hero" aria-labelledby="ads-hero-title">
          <div class="ds-container ads-hero__grid">
            <div class="ads-hero__copy">
              <p class="ads-kicker">Devisia · Trieste · Friuli Venezia Giulia</p>
              <h1 id="ads-hero-title">{hero.title}</h1>
              <p class="ads-hero__lede">{hero.lede}</p>
              <div class="ads-hero__actions">
                <Button href="#ads-form" size="lg" data-surface="hero" data-ads-form-cta>
                  {CTA_LABEL}
                </Button>
              </div>
            </div>

            <div class="ads-hero__system" aria-hidden="true">
              <span class="ads-hero__system-mark">SYS</span>
              <span class="ads-hero__axis ads-hero__axis--a"></span>
              <span class="ads-hero__axis ads-hero__axis--b"></span>
              <div class="ads-hero__node ads-hero__node--process">
                <span>Processo</span>
                <strong>regole e ruoli</strong>
              </div>
              <div class="ads-hero__node ads-hero__node--data">
                <span>Dati</span>
                <strong>flussi e API</strong>
              </div>
              <div class="ads-hero__node ads-hero__node--ai">
                <span>AI</span>
                <strong>uso controllato</strong>
              </div>
              <div class="ads-hero__node ads-hero__node--proof">
                <span>Prova</span>
                <strong>log e audit</strong>
              </div>
            </div>
          </div>
        </section>

        <section class="ads-local ds-container" aria-labelledby="local-title">
          <div class="ads-local__card">
            <p class="ads-local__eyebrow">Sede</p>
            <p class="ads-local__address">
              Riva Tommaso Gulli 12<br />34123 Trieste
            </p>
            <a class="ads-local__phone" href={PHONE_HREF}>{PHONE_NUMBER}</a>
          </div>
          <div class="ads-local__copy">
            <h2 id="local-title">Tecnologia costruita vicino all’impresa</h2>
            <p>
              Devisia ha sede a Trieste e lavora con imprese del Friuli Venezia Giulia su software,
              Microsoft 365, integrazioni, automazioni e sistemi AI. La vicinanza non sostituisce il
              metodo, ma rende più semplice capire processi, responsabilità e vincoli operativi.
            </p>
          </div>
        </section>

        <section class="ads-examples ds-container" aria-labelledby="examples-title">
          <div class="ads-section-head">
            <h2 id="examples-title">Esempi di intervento</h2>
            <p>
              Non partiamo da un prodotto da collocare, ma dal punto in cui il processo perde tempo,
              dati o controllo.
            </p>
          </div>

          <div class="ads-example-grid">
            {
              interventions.map((item) => (
                <article class="ads-example">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))
            }
          </div>

          <div class="ads-m365">
            <p class="ads-m365__caption" id="m365-caption">
              Il perimetro Microsoft 365 su cui interveniamo più spesso
            </p>
            <ul class="ads-m365__flow" aria-labelledby="m365-caption">
              {
                m365Layers.map((layer) => (
                  <li>
                    <span>{layer.label}</span>
                    <strong>{layer.value}</strong>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <section class="ads-fit ds-container" aria-labelledby="fit-title">
          <div class="ads-fit__intro">
            <span aria-hidden="true">FIT</span>
            <h2 id="fit-title">Quando ha senso parlarci</h2>
          </div>
          <ul class="ads-fit__list">
            {qualificationSignals.map((signal) => <li>{signal}</li>)}
          </ul>
        </section>

        <section class="ads-services" aria-labelledby="services-title">
          <div class="ds-container">
            <div class="ads-section-head">
              <h2 id="services-title">Cosa possiamo costruire</h2>
              <p>
                Tre aree di lavoro ricorrenti. Quale ti serve davvero si decide dopo aver guardato
                il processo, non prima.
              </p>
            </div>

            <div class="ads-service-grid">
              {
                services.map((service) => (
                  <article class="ads-service">
                    <span>{service.label}</span>
                    <h3>{service.title}</h3>
                    <p>{service.text}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="ads-method" aria-labelledby="method-title">
          <div class="ds-container ads-method__grid">
            <div>
              <p class="ads-method__mark" aria-hidden="true">01-05</p>
              <h2 id="method-title">Come affrontiamo i progetti</h2>
              <p>
                Prima di stimare o sviluppare mettiamo ordine nel problema: meno soluzioni
                complicate senza motivo, responsabilità più chiare e decisioni tecniche che restano
                valide anche dopo il rilascio.
              </p>
            </div>

            <ol class="ads-method__steps">
              {
                methodSteps.map((step, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <p>{step}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>
      </article>
    </div>

    <aside id="ads-form" class="ads-form-panel" data-ads-form-panel aria-labelledby="ads-form-title">
      <div class="ads-form-panel__inner">
        <header class="ads-form-panel__header">
          <p class="ads-form-panel__eyebrow">Richiesta</p>
          <h2 id="ads-form-title" tabindex="-1">Parliamo del tuo processo</h2>
          <p class="ads-form-panel__lede">
            Bastano tre righe: situazione attuale, obiettivo e vincoli da considerare.
          </p>
        </header>
        {
          isSuccess && (
            <div id="contact-success" class="ads-form-panel__success" role="status" tabindex="-1">
              <h3>Messaggio ricevuto.</h3>
              <p>
                Grazie. Leggiamo la richiesta e ti rispondiamo con domande mirate o un primo passo
                chiaro.
              </p>
            </div>
          )
        }
        <ContactForm
          lang="it"
          showHeading={false}
          fieldIdPrefix="landing-"
          source={LANDING_SOURCE}
          trackingSource={LANDING_SOURCE}
          formId="landing-devisia"
          pagePath={LANDING_PATH}
          variant="contact"
          submitLabel="Invia la richiesta"
          fieldCopy={{
            name: 'Nome e cognome',
            email: 'Email di lavoro',
            subject: 'Oggetto, facoltativo',
            message: 'Messaggio',
            messagePlaceholder:
              'Descrivi cosa succede oggi, cosa vorresti cambiare e quali vincoli non possiamo ignorare.',
          }}
        />
      </div>
    </aside>
  </div>

  <div class="ads-form-dock-bar" data-form-dock-bar data-visible="false">
    <button type="button" class="ads-form-dock" data-form-dock aria-controls="ads-form">
      {CTA_LABEL}
    </button>
  </div>
</Layout>

<style>
  .ads-landing-shell {
    width: 100%;
    --ads-edge: var(--ds-container-pad);
    --ads-gap: clamp(1.5rem, 2.5vw, 2.5rem);
    --ads-rail: clamp(24rem, 24vw, 26rem);
  }

  .ads-landing-shell__main {
    min-width: 0;
  }

  .ads-landing {
    background:
      linear-gradient(
          90deg,
          color-mix(in oklch, var(--ds-color-accent-2) 7%, transparent) 1px,
          transparent 1px
        ),
      var(--ds-color-bg);
    background-size: clamp(3rem, 8vw, 5.5rem) clamp(3rem, 8vw, 5.5rem);
  }

  /* ---------------------------------------------------------------- Hero */

  .ads-hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--ds-hero-padding-top);
    padding-bottom: var(--ds-hero-padding-bottom);
    background:
      radial-gradient(
        circle at 82% 18%,
        color-mix(in oklch, var(--ds-color-accent) 28%, transparent),
        transparent 32%
      ),
      linear-gradient(
        118deg,
        transparent 0 56%,
        color-mix(in oklch, var(--ds-color-accent-2) 18%, transparent) 56% 59%,
        transparent 59%
      ),
      var(--ds-color-hero-tint);
    color: color-mix(in oklch, white 94%, var(--ds-color-hero-tint));
  }

  .ads-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, color-mix(in oklch, white 10%, transparent) 1px, transparent 1px),
      linear-gradient(0deg, color-mix(in oklch, white 9%, transparent) 1px, transparent 1px);
    background-size: clamp(3.5rem, 7vw, 6.5rem) clamp(3.5rem, 7vw, 6.5rem);
    mask-image: linear-gradient(90deg, black, black 72%, transparent);
    opacity: 0.5;
  }

  .ads-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .ads-hero__grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(24rem, 0.88fr);
    }
  }

  .ads-kicker {
    margin: 0 0 var(--ds-space-4);
    color: color-mix(in oklch, var(--ds-color-accent-2) 78%, white);
    font-family: var(--ds-font-ui);
    font-size: var(--ds-text-xs);
    font-weight: 850;
    letter-spacing: var(--ds-tracking-caps);
    text-transform: uppercase;
    text-wrap: balance;
  }

  .ads-hero h1 {
    max-width: min(var(--ds-hero-title-max), 100%);
    margin: 0;
    color: color-mix(in oklch, white 96%, var(--ds-color-hero-tint));
    font-family: var(--ds-font-display);
    font-size: var(--ds-hero-title-size);
    font-weight: 820;
    letter-spacing: var(--ds-hero-title-tracking);
    line-height: var(--ds-hero-title-leading);
    text-wrap: balance;
  }

  .ads-hero__lede {
    max-width: 60ch;
    margin: var(--ds-space-6) 0 0;
    color: color-mix(in oklch, white 84%, var(--ds-color-hero-tint));
    font-size: clamp(1.08rem, 0.75vw + 1rem, 1.35rem);
    line-height: var(--ds-leading-relaxed);
    text-wrap: pretty;
  }

  .ads-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-4);
    align-items: center;
    margin-top: var(--ds-space-6);
  }

  .ads-hero__actions :global(.ds-btn[data-surface='hero']) {
    font-size: clamp(1rem, 0.92rem + 0.35vw, 1.12rem);
  }

  .ads-hero__system {
    position: relative;
    min-height: clamp(24rem, 38vw, 34rem);
    border: 1px solid color-mix(in oklch, white 16%, var(--ds-color-hero-tint));
    background:
      radial-gradient(
        circle at 26% 24%,
        color-mix(in oklch, var(--ds-color-accent-2) 36%, transparent),
        transparent 30%
      ),
      radial-gradient(
        circle at 76% 76%,
        color-mix(in oklch, var(--ds-color-accent) 26%, transparent),
        transparent 32%
      ),
      color-mix(in oklch, white 5%, var(--ds-color-hero-tint));
    clip-path: polygon(0 6%, 100% 0, 96% 94%, 6% 100%);
    overflow: hidden;
  }

  .ads-hero__system::before {
    content: '';
    position: absolute;
    inset: 9%;
    border: 1px dashed color-mix(in oklch, white 22%, transparent);
    transform: skewY(-7deg);
  }

  .ads-hero__system-mark {
    position: absolute;
    right: -0.15em;
    bottom: -0.18em;
    color: color-mix(in oklch, white 10%, transparent);
    font-family: var(--ds-font-display);
    font-size: clamp(6rem, 14vw, 12rem);
    font-weight: 850;
    letter-spacing: -0.12em;
    line-height: 0.8;
  }

  .ads-hero__axis {
    position: absolute;
    background: color-mix(in oklch, white 22%, transparent);
  }

  .ads-hero__axis--a {
    left: 12%;
    right: 12%;
    top: 51%;
    height: 1px;
    transform: rotate(-14deg);
  }

  .ads-hero__axis--b {
    top: 13%;
    bottom: 13%;
    left: 52%;
    width: 1px;
    transform: rotate(15deg);
  }

  .ads-hero__node {
    position: absolute;
    display: grid;
    gap: var(--ds-space-1);
    width: min(12rem, 42%);
    padding: var(--ds-space-3);
    border: 1px solid color-mix(in oklch, white 18%, var(--ds-color-hero-tint));
    background: color-mix(in oklch, white 7%, var(--ds-color-hero-tint));
    box-shadow: 0 22px 46px color-mix(in oklch, var(--ds-color-hero-tint) 62%, transparent);
  }

  .ads-hero__node span {
    color: var(--ds-color-accent-2);
    font-size: var(--ds-text-xs);
    font-weight: 850;
    letter-spacing: var(--ds-tracking-caps);
    text-transform: uppercase;
  }

  .ads-hero__node strong {
    color: color-mix(in oklch, white 92%, var(--ds-color-hero-tint));
    font-family: var(--ds-font-display);
    font-size: var(--ds-text-md);
    line-height: var(--ds-leading-tight);
  }

  .ads-hero__node--process {
    left: 8%;
    top: 15%;
  }

  .ads-hero__node--data {
    right: 9%;
    top: 25%;
  }

  .ads-hero__node--ai {
    left: 14%;
    bottom: 18%;
    border-color: color-mix(in oklch, var(--ds-color-accent) 45%, transparent);
  }

  .ads-hero__node--proof {
    right: 11%;
    bottom: 12%;
    background: color-mix(in oklch, var(--ds-color-accent) 32%, var(--ds-color-hero-tint));
  }

  /* ------------------------------------------------------ Local presence */

  .ads-local {
    display: grid;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: stretch;
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  @media (min-width: 62rem) {
    .ads-local {
      grid-template-columns: minmax(14rem, 0.52fr) minmax(0, 1.48fr);
    }
  }

  .ads-local__card {
    display: grid;
    align-content: start;
    gap: var(--ds-space-3);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid color-mix(in oklch, var(--ds-color-accent-2) 38%, var(--ds-color-border));
    background:
      linear-gradient(
        135deg,
        color-mix(in oklch, var(--ds-color-accent-2) 14%, transparent),
        transparent 48%
      ),
      var(--ds-color-surface);
  }

  .ads-local__eyebrow {
    margin: 0;
    color: color-mix(in oklch, var(--ds-color-accent-2) 84%, var(--ds-color-text));
    font-family: var(--ds-font-ui);
    font-size: var(--ds-text-xs);
    font-weight: 850;
    letter-spacing: var(--ds-tracking-caps);
    text-transform: uppercase;
  }

  .ads-local__address {
    margin: 0;
    color: var(--ds-color-text);
    font-family: var(--ds-font-display);
    font-size: var(--ds-text-lg);
    line-height: var(--ds-leading-tight);
  }

  .ads-local__phone {
    justify-self: start;
    margin: 0;
    padding: 0;
    color: var(--ds-color-accent);
    font-family: var(--ds-font-ui);
    font-size: var(--ds-text-sm);
    font-weight: 800;
    letter-spacing: var(--ds-tracking-caps);
  }

  .ads-local__copy {
    max-width: 68ch;
  }

  /* ---------------------------------------------- Intervention examples */

  .ads-examples {
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
  }

  .ads-example-grid,
  .ads-service-grid {
    display: grid;
    gap: clamp(0.9rem, 2vw, 1.2rem);
  }

  @media (min-width: 56rem) {
    .ads-example-grid,
    .ads-service-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .ads-example {
    display: grid;
    align-content: start;
    gap: var(--ds-space-3);
    padding: clamp(1.25rem, 3vw, 1.85rem);
    border: 1px solid var(--ds-color-border);
    border-top: 2px solid color-mix(in oklch, var(--ds-color-accent-2) 70%, var(--ds-color-border));
    background: var(--ds-color-surface);
  }

  .ads-example h3 {
    margin: 0;
    font-family: var(--ds-font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem);
    line-height: var(--ds-leading-tight);
    text-wrap: balance;
  }

  .ads-example p {
    margin: 0;
    color: var(--ds-color-text-muted);
    font-size: var(--ds-text-md);
    line-height: var(--ds-leading-relaxed);
    text-wrap: pretty;
  }

  .ads-m365 {
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .ads-m365__caption {
    margin: 0 0 var(--ds-space-3);
    color: color-mix(in oklch, var(--ds-color-accent-2) 82%, var(--ds-color-text));
    font-family: var(--ds-font-ui);
    font-size: var(--ds-text-xs);
    font-weight: 800;
    letter-spacing: var(--ds-tracking-caps);
    text-transform: uppercase;
  }

  .ads-m365__flow {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid color-mix(in oklch, var(--ds-color-accent-2) 35%, var(--ds-color-border));
    background: color-mix(in oklch, var(--ds-color-accent-2) 30%, var(--ds-color-border));
    list-style: none;
  }

  @media (min-width: 44rem) {
    .ads-m365__flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ads-m365__flow li {
    display: grid;
    gap: var(--ds-space-1);
    margin: 0;
    padding: 0.85rem 0.95rem;
