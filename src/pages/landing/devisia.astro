      position: sticky;
      top: var(--ds-site-header-offset);
      z-index: 2;
      align-self: start;
      max-height: calc(100dvh - var(--ds-site-header-offset) - 1.5rem);
      overflow: auto;
      overscroll-behavior: contain;
    }

    /* Compact the panel form so it fits a laptop viewport without an internal
       scrollbar. Scoped to this panel only (not the shared ContactForm used on
       other pages); overflow stays as a safety net for very short windows. */
    .ads-form-panel__inner {
      padding: clamp(1rem, 1.4vw, 1.25rem);
    }

    .ads-form-panel__header {
      gap: var(--ds-space-1);
      margin-bottom: var(--ds-space-4);
    }

    .ads-form-panel__lede {
