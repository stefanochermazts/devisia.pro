</style>

<script>
  import { captureUtmFromLocation } from '../../lib/utm';
  import { trackLeadEvent } from '../../lib/leadTracking';

  const shell = document.querySelector('[data-ads-landing]');
  const panel = document.querySelector('[data-ads-form-panel]');

  if (shell instanceof HTMLElement && panel instanceof HTMLElement) {
    const source = shell.dataset.landingSource || '';
    const pagePath = shell.dataset.landingPath || '';

    // Persists the LinkedIn UTMs for the session even if the visitor moves
    // around before opening the form; the form hydrates its hidden fields
    // from the same store.
    captureUtmFromLocation();
    trackLeadEvent({ event: 'landing_view', source, pagePath });

    const heading = panel.querySelector('#ads-form-title');
    const firstField = panel.querySelector('#landing-name');
    const dockBar = document.querySelector('[data-form-dock-bar]');
    const dock = document.querySelector('[data-form-dock]');
    const railQuery = window.matchMedia('(min-width: 75rem)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const focusWithoutScroll = (node: unknown) => {
      if (!(node instanceof HTMLElement)) return;
      try {
        node.focus({ preventScroll: true });
      } catch {
        node.focus();
      }
    };

    const goToForm = () => {
      // On wide screens the form is already pinned beside the content, so
      // scrolling would be disorienting: jump straight into the first field.
      if (railQuery.matches) {
        focusWithoutScroll(firstField);
        return;
      }
      panel.scrollIntoView({
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
        block: 'start',
      });
      focusWithoutScroll(heading);
    };

    document.querySelectorAll('[data-ads-form-cta]').forEach((node) => {
      node.addEventListener('click', (event) => {
        event.preventDefault();
        trackLeadEvent({ event: 'hero_cta_click', source, pagePath });
        goToForm();
      });
    });

    if (dock instanceof HTMLButtonElement && dockBar instanceof HTMLElement) {
      dock.addEventListener('click', () => {
        trackLeadEvent({ event: 'hero_cta_click', source, pagePath });
        goToForm();
      });

      // The CTA is a shortcut, not a permanent overlay: it stays out of the way
      // while the hero's own CTA is on screen, and steps aside as soon as the
      // form or the footer is reachable, so it never covers them.
      const hero = shell.querySelector('.ads-hero');
      const footer = document.querySelector('.site-footer');
      const blockers = new Set();

      const sync = () => {
        dockBar.dataset.visible = String(!railQuery.matches && blockers.size === 0);
      };

      if ('IntersectionObserver' in window) {
        const observe = (target: Element | null, rootMargin: string) => {
          if (!target) return;
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) blockers.add(entry.target);
                else blockers.delete(entry.target);
              });
              sync();
            },
            { rootMargin }
          );
          observer.observe(target);
        };

        // The negative bottom margin encodes "substantially visible": the form
        // only counts once it reaches the upper three quarters of the viewport.
        observe(panel, '0px 0px -25% 0px');
        observe(footer, '0px');
        observe(hero, '0px');
      }

      railQuery.addEventListener('change', sync);
      sync();
    }

    if (shell.dataset.landingSuccess === 'true') {
      requestAnimationFrame(() => {
        focusWithoutScroll(document.getElementById('contact-success'));
      });
    }
  }
</script>
