---
import type { LandingPageConfig } from '../../data/landing/types';

interface Props {
  config: LandingPageConfig;
}

const { config } = Astro.props;
---

<section class="campaign-landing__section" aria-labelledby="campaign-problem-title">
  <div class="campaign-landing__inner">
    <div class="campaign-problem__content">
      <h2 id="campaign-problem-title" class="campaign-landing__section-title">
        {config.problem.title}
      </h2>
      <p class="campaign-landing__prose">{config.problem.text}</p>
    </div>
  </div>
</section>
