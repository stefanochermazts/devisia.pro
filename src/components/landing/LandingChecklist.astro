---
import type { LandingPageConfig } from '../../data/landing/types';

interface Props {
  config: LandingPageConfig;
}

const { config } = Astro.props;
const { checklist } = config;
---

<section
  class="campaign-landing__section campaign-landing__section--surface"
  aria-labelledby="campaign-checklist-title"
>
  <div class="campaign-landing__inner">
    <h2 id="campaign-checklist-title" class="campaign-landing__section-title">
      {checklist.title}
    </h2>
    <ul class="campaign-register" data-kind={checklist.kind} role="list">
      {
        checklist.items.map((item) => (
          <li class="campaign-register__item">
            <p class="campaign-register__text">{item}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
