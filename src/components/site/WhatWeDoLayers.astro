---
export interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const isEn = lang === 'en';

const rows = isEn
  ? [
      { tag: 'SW', title: 'Build', body: 'Platforms and applications designed to last, integrate and stay maintainable.' },
      { tag: 'IN', title: 'Integrate', body: 'Data, systems and ownership made explicit before automation multiplies them.' },
      { tag: 'AI', title: 'Govern AI', body: 'Models inside clear perimeters: logging, validation, human oversight.' },
      { tag: 'EV', title: 'Prove', body: 'Evidence that shows what ran, who decided, and what can be exported.' },
    ]
  : [
      { tag: 'SW', title: 'Costruire', body: 'Piattaforme e applicazioni pensate per durare, integrarsi e restare manutenibili.' },
      { tag: 'IN', title: 'Integrare', body: 'Dati, sistemi e responsabilità espliciti prima che l’automazione li moltiplichi.' },
      { tag: 'AI', title: 'Governare AI', body: 'Modelli dentro perimetri chiari: logging, validazione, supervisione umana.' },
      { tag: 'EV', title: 'Dimostrare', body: 'Evidenze su cosa è corso, chi ha deciso e cosa si può esportare.' },
    ];
---

<section class="sheet-rail what-we-do-sheet" aria-hidden="true">
  {
    rows.map((row) => (
      <article class="sheet-rail__item">
        <span class="sheet-rail__tag">TAG · {row.tag}</span>
        <h3>{row.title}</h3>
        <p>{row.body}</p>
      </article>
    ))
  }
</section>
