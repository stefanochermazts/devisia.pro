---
export interface Props {
  lang?: 'it' | 'en';
}

const { lang = 'it' } = Astro.props;

const copy =
  lang === 'en'
    ? {
        eyebrow: 'Devisia Chat',
        title: 'Ask the site. Get answers you can verify.',
        signal: 'Grounded answers, visible boundaries, no black box.',
        lead: 'A guided assistant helps you explore services, method and AI governance without hunting through every page. It answers only from public Devisia content and makes the technical perimeter visible: exported Markdown, indexed knowledge, RAG orchestration and server guardrails.',
        cta: 'Try the chat',
        ctaHint: 'Open a dedicated page for longer questions, or use the floating assistant while browsing.',
        proofLabel: 'Reliability markers',
        proofPoints: ['Markdown source', 'Server-side proxy', 'Public perimeter'],
        pipelineLabel: 'How it stays reliable',
        visualWord: 'CHAT',
        previewBadge: 'RAG',
        steps: [
          {
            id: '01',
            title: 'Readable knowledge',
            body: 'Public pages are exported to clean Markdown with frontmatter, so every answer starts from content that is readable, versionable and traceable.',
          },
          {
            id: '02',
            title: 'Search-ready ingestion',
            body: 'The exported content is split into retrieval chunks, letting the assistant select relevant passages before composing a reply.',
          },
          {
            id: '03',
            title: 'RAG, behind a proxy',
            body: 'Requests pass through a server-side proxy: the RAG stack orchestrates the agent, while credentials and tokens stay server side.',
          },
          {
            id: '04',
            title: 'Guardrails by design',
            body: 'The chat keeps to public content, sanitises Markdown output and avoids collecting secrets or private operational data.',
          },
        ],
        previewUser: 'Can you explain your AI approach in plain language?',
        previewAssistant:
          'Yes. We design AI systems with clear scope, governance and evidence, so teams can use them without losing control.',
      }
    : {
        eyebrow: 'Chat Devisia',
        title: 'Hai una domanda? Chiedila direttamente al sito.',
        signal: 'Risposte chiare, basate su ciò che abbiamo pubblicato.',
        lead: 'Scrivi la tua domanda come se la stessi facendo a una persona del team. La chat cerca nelle pagine Devisia e riunisce le informazioni utili in una risposta semplice. Così puoi capire più velocemente come lavoriamo, cosa possiamo fare per la tua azienda e se siamo il partner giusto.',
        cta: 'Prova la chat',
        ctaHint: 'Puoi aprire la chat completa oppure usare l’assistente mentre navighi.',
        proofLabel: 'Come risponde la chat',
        proofPoints: ['Solo contenuti pubblici', 'Risposte basate sulle fonti', 'Dati protetti'],
        pipelineLabel: 'Come funziona la chat',
        visualWord: 'CHAT',
        previewBadge: 'FONTI DEL SITO',
        steps: [
          {
            id: '01',
            title: 'Legge ciò che pubblichiamo',
            body: 'La chat usa i contenuti pubblici del sito: servizi, metodo, progetti e approfondimenti scritti dal team Devisia.',
          },
          {
            id: '02',
            title: 'Trova le informazioni utili',
            body: 'Quando fai una domanda, individua nelle nostre pagine i passaggi più pertinenti, senza costringerti a cercarli uno per uno.',
          },
          {
            id: '03',
            title: 'Prepara una risposta chiara',
            body: 'Riunisce le informazioni trovate e le traduce in una risposta diretta, basata sulle pagine del sito.',
          },
          {
            id: '04',
            title: 'Rispetta confini e dati',
            body: 'Risponde solo su informazioni pubbliche e non richiede password, accessi ai sistemi o dati riservati della tua azienda.',
          },
        ],
        previewUser: 'Come potete aiutarci a introdurre l’AI senza perdere il controllo?',
        previewAssistant:
          'Partiamo da un obiettivo concreto, definiamo dove l’AI può essere utile e fissiamo regole chiare su dati e responsabilità. Così il sistema resta sotto il controllo del tuo team.',
      };

const chatHref = lang === 'en' ? '/en/chat' : '/chat';
---

<section
  class="site-section site-section--tint home-chat"
  aria-labelledby="home-chat-heading"
  data-visual-word={copy.visualWord}
>
  <div class="ds-container home-chat__grid">
    <div class="home-chat__copy">
      <p class="site-eyebrow">{copy.eyebrow}</p>
      <h2 id="home-chat-heading" class="site-h2 home-chat__headline">{copy.title}</h2>
      <p class="home-chat__signal">{copy.signal}</p>
      <p class="site-lead">{copy.lead}</p>
      <ul class="home-chat__proof" aria-label={copy.proofLabel}>
        {copy.proofPoints.map((point) => <li>{point}</li>)}
      </ul>
      <p class="home-chat__actions">
        <a class="ds-btn" data-variant="primary" data-size="lg" href={chatHref}>
          {copy.cta}
        </a>
      </p>
      <p class="home-chat__cta-hint">{copy.ctaHint}</p>
    </div>

    <section class="home-chat__aside" aria-label={copy.pipelineLabel}>
      <ol class="home-chat__pipeline">
        {
          copy.steps.map((step) => (
            <li class="home-chat__step">
              <span class="home-chat__step-id" aria-hidden="true">
                {step.id}
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="home-chat__preview" aria-hidden="true">
        <header class="home-chat__preview-top">
          <span>{copy.eyebrow}</span>
          <span>{copy.previewBadge}</span>
        </header>
        <div class="home-chat__preview-thread">
          <p class="home-chat__preview-msg home-chat__preview-msg--user">{copy.previewUser}</p>
          <p class="home-chat__preview-msg home-chat__preview-msg--assistant">{copy.previewAssistant}</p>
        </div>
      </div>
    </section>
  </div>
</section>
