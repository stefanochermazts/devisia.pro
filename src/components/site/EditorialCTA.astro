---
export interface Props {
  title: string;
  copy: string;
  ctaLabel: string;
  ctaHref: string;
  variant?: 'default' | 'tint' | 'dark';
  headingId?: string;
}
const { title, copy, ctaLabel, ctaHref, variant = 'default', headingId = 'editorial-cta-h' } = Astro.props;
const mod =
  variant === 'tint' ? ' site-section--tint' : variant === 'dark' ? ' site-section--dark' : '';
---

<section class={`site-section${mod}`} aria-labelledby={headingId}>
  <section class="ds-container">
    <section class="site-cta">
      <h2 id={headingId} class="site-h2 site-cta__title">
        {title}
      </h2>
      <p class="site-lead">{copy}</p>
      <a class="ds-btn site-cta__button" data-variant="primary" data-size="lg" href={ctaHref}>
        {ctaLabel}
      </a>
    </section>
  </section>
</section>
